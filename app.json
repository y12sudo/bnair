{
  "expo": {
    "name": "Outfit Saver",
    "slug": "outfit-saver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.outfitsaver.app",
      "infoPlist": {}
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F4EF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.outfitsaver.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "outfitsaver",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Outfit Saver uses the camera to photograph your clothes and accessories.",
          "photosPermission": "Outfit Saver lets you pick photos of your clothes from your library.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Outfit Saver uses your approximate location to show today’s weather and suggest outfits for it."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
