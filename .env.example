# Copy this file to .env and fill it in.

# ---- Security ---------------------------------------------------------------
# Long random password. The same value goes into every TradingView alert message.
WEBHOOK_SECRET=change-me-to-a-long-random-string

# ---- Mode -------------------------------------------------------------------
# dry_run = simulated, no MT5 needed (just to test that alerts arrive)
# mt5     = place orders through MetaTrader 5 (use your IUX DEMO account first!)
MODE=dry_run

# ---- IUX MetaTrader 5 login ---------------------------------------------------
# Leave these empty to use whatever account is already logged in inside MT5.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Full path to terminal64.exe, only needed if you have more than one MT5 installed
MT5_PATH=

# ---- What to trade ------------------------------------------------------------
# Exact gold symbol name from IUX MT5 "Market Watch" (it may have a suffix)
SYMBOL=XAUUSD
# TradingView tickers the bot accepts (alerts from any other chart are ignored)
ALLOWED_TICKERS=XAUUSD,GOLD

# ---- Risk -------------------------------------------------------------------
# % of your account lost if the stop-loss is hit. 1 = 1%.
RISK_PERCENT=1.0
# atr   = stop-loss distance = SL_ATR_MULT x ATR (adapts to volatility)
# fixed = stop-loss distance = SL_FIXED_DISTANCE (price units, 5.0 = $5 on gold)
SL_MODE=atr
SL_ATR_MULT=1.5
ATR_PERIOD=14
# Set this to the same timeframe as your TradingView chart (M1, M5, M15, M30, H1, H4, D1)
ATR_TIMEFRAME=M15
SL_FIXED_DISTANCE=5.0
# Take-profit distance = SL distance x TP_RR  (2.0 = aim to win 2x what you risk)
TP_RR=2.0
# Stop opening new trades for the day after losing this % of the account
MAX_DAILY_LOSS_PERCENT=3.0
# Skip the trade if the spread is wider than this (price units, 1.0 = $1 on gold). 0 = off
MAX_SPREAD=1.0
# Never open more than this many lots, whatever the risk maths says
MAX_LOT=1.0
# true  = opposite signal closes the trade AND opens a new one the other way
# false = opposite signal only closes the trade
REVERSE_ON_OPPOSITE=true

# ---- Plumbing -------------------------------------------------------------------
# Tags the bot's trades so it never touches trades you open by hand
MAGIC=250302
# Ignore a repeat of the same alert within this many seconds
DEDUPE_SECONDS=30
# Max slippage allowed on market orders, in points
DEVIATION_POINTS=50
HOST=0.0.0.0
PORT=80
DRY_RUN_BALANCE=10000
LOG_DIR=logs
